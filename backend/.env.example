# PostgreSQL connection string (PostGIS-enabled database)
DATABASE_URL="postgresql://localhost:5432/civiclens?schema=public"

# Server
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Gemini API (optional — if omitted, CivicLens automatically falls back to a
# deterministic mock AI service so the full demo still works offline)
GEMINI_API_KEY=

# Images are stored as blobs directly in Postgres (StoredImage table) and served
# at /api/images/<id>. This survives free-tier restarts because the database
# persists even though host disks are ephemeral. No extra configuration needed.
