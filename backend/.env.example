# PostgreSQL connection string (PostGIS-enabled database)
DATABASE_URL="postgresql://localhost:5432/civiclens?schema=public"

# Server
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Gemini API (optional — if omitted, CivicLens automatically falls back to a
# deterministic mock AI service so the full demo still works offline)
GEMINI_API_KEY=

# Object storage (optional). When set, uploaded images are pushed to an
# S3-compatible bucket (Cloudflare R2, AWS S3, etc.) and served from
# OBJECT_STORAGE_URL — this is required on Render free tier where the local
# filesystem is wiped on every restart/redeploy.
#   OBJECT_STORAGE_URL      public base URL, e.g. https://pub-<hash>.r2.dev
#   OBJECT_STORAGE_ENDPOINT S3 API endpoint, e.g. https://<accountid>.r2.cloudflarestorage.com
#   OBJECT_STORAGE_REGION   bucket region (Cloudflare R2 uses "auto")
#   OBJECT_STORAGE_BUCKET   bucket name
#   OBJECT_STORAGE_ACCESS_KEY
#   OBJECT_STORAGE_SECRET_KEY
# When omitted, images are stored on local disk under backend/uploads and
# served from /uploads (OK for local dev only).
OBJECT_STORAGE_URL=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
