// CivicLens — Prisma schema
// PostgreSQL + PostGIS. Geospatial proximity queries (duplicate detection,
// map bounding-box queries) use raw SQL against a `geography(Point,4326)`
// column that is kept in sync with lat/lng via a database trigger — see
// prisma/migrations/*_postgis/migration.sql.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum Role {
  CITIZEN
  AUTHORITY
}

enum Category {
  POTHOLE
  STREETLIGHT
  GARBAGE
  WATER_LEAKAGE
  DAMAGED_FOOTPATH
  OPEN_DRAIN
  OTHER
}

enum Severity {
  LOW
  MEDIUM
  HIGH
}

enum TrafficExposure {
  LOW
  MEDIUM
  HIGH
}

enum IssueStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  REOPENED
}

enum VerificationStatus {
  PENDING
  LIKELY_RESOLVED
  UNCLEAR
  NOT_RESOLVED
}

enum Department {
  ROAD_MAINTENANCE
  SANITATION
  ELECTRICAL
  WATER_WORKS
  PARKS_HORTICULTURE
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      Role     @default(CITIZEN)
  createdAt DateTime @default(now())

  reports          Report[]
  citizenFeedbacks CitizenFeedback[]
}

model CivicIssue {
  id              String          @id @default(cuid())
  code            String          @unique // e.g. CIV-042
  title           String
  category        Category
  description     String?
  severity        Severity
  priorityScore   Int             @default(0)
  priorityLevel   String          @default("LOW")
  trafficExposure TrafficExposure @default(MEDIUM)
  status          IssueStatus     @default(OPEN)
  department      Department?
  latitude        Float
  longitude       Float
  locationName    String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  reports   Report[]
  resolutions Resolution[]
  feedbacks CitizenFeedback[]
  events    IssueEvent[]

  @@index([status])
  @@index([priorityScore])
}

model Report {
  id           String     @id @default(cuid())
  issue        CivicIssue @relation(fields: [issueId], references: [id])
  issueId      String
  user         User?      @relation(fields: [userId], references: [id])
  userId       String?
  reporterName String     @default("Anonymous Citizen")
  imageUrl     String
  description  String?
  latitude     Float
  longitude    Float
  aiCategory   Category
  aiSeverity   Severity
  aiConfidence Float
  embedding    Float[]    @default([])
  createdAt    DateTime   @default(now())

  @@index([issueId])
}

model Resolution {
  id                     String              @id @default(cuid())
  issue                  CivicIssue          @relation(fields: [issueId], references: [id])
  issueId                String
  beforeImageUrl         String
  afterImageUrl          String
  verificationStatus     VerificationStatus  @default(PENDING)
  verificationConfidence Float               @default(0)
  verificationNotes      String?
  verifiedAt             DateTime?
  createdAt              DateTime            @default(now())

  @@index([issueId])
}

model CitizenFeedback {
  id        String     @id @default(cuid())
  issue     CivicIssue @relation(fields: [issueId], references: [id])
  issueId   String
  user      User?      @relation(fields: [userId], references: [id])
  userId    String?
  resolved  Boolean
  createdAt DateTime   @default(now())

  @@index([issueId])
}

// Append-only activity log powering the issue timeline UI.
model IssueEvent {
  id        String     @id @default(cuid())
  issue     CivicIssue @relation(fields: [issueId], references: [id])
  issueId   String
  type      String
  message   String
  createdAt DateTime   @default(now())

  @@index([issueId])
}

// Image binary blobs stored directly in Postgres (BYTEA). Free-tier hosts
// (Render, Neon, Supabase) wipe or recycle ephemeral disks but always keep the
// database, so holding image bytes in the DB means uploaded photos survive
// restarts/redeploys with no external object-storage account or credit card.
// `id` is the same key referenced by Report.imageUrl / Resolution.*ImageUrl as
// /api/images/<id>.
model StoredImage {
  id        String   @id
  data      Bytes
  mimeType  String
  createdAt DateTime @default(now())
}
